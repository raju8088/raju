# VoiceNuvo Phase 2 — Production Database, Authentication & Security Configuration
# Copy this file to .env.local for local overrides

# Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session Signing Secret (REQUIRED in production: Generate with `openssl rand -base64 32`)
SESSION_SECRET=your-secure-random-32-character-session-secret-here

# Database Configuration (MANDATORY in production; fail-fast if missing)
# - Production: DATABASE_URL is strictly required. Application will NOT start without it.
# - Development/Test: If DATABASE_URL is unset, falls back to embedded PGlite in PGLITE_DATA_DIR.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
PGLITE_DATA_DIR=./data/voicenuvo_pg

# Seed Data Control:
# In production, demo users are NOT created automatically.
# Set SEED_DEMO_DATA=true only for development/staging environments.
SEED_DEMO_DATA=false

# Supabase Public & Service Keys (Cloud PostgreSQL / Storage / Edge integration):
# Notice: SUPABASE_SERVICE_ROLE_KEY is strictly server-only and NEVER prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
