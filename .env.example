# VoiceNuvo — Complete Environment Variable Reference
# Phase 8 Production Readiness Edition
#
# Classification legend:
#   PUBLIC       — Safe to expose to the browser (NEXT_PUBLIC_ prefix)
#   SERVER_ONLY  — Loaded server-side only; never sent to browser
#   SECRET       — Cryptographically sensitive; must be rotated on compromise
#   REQUIRED     — Application will NOT start without this in production
#   OPTIONAL     — Has a default or degrades gracefully
#
# Copy this file to .env.local for local dev, and configure secrets via
# your deployment platform's secure secret store (Vercel / Railway / Render).
#
# ─── NEVER COMMIT REAL VALUES HERE ────────────────────────────────────────────

# =============================================================================
# RUNTIME ENVIRONMENT
# =============================================================================
# Classification: SERVER_ONLY | REQUIRED
# Values: development | staging | production
NODE_ENV=development

# =============================================================================
# APPLICATION
# =============================================================================
# Classification: PUBLIC | REQUIRED
# The canonical, externally accessible URL of this deployment.
# Used for constructing webhook callback URLs, CORS origin checks, and cookies.
# In production: must be the real HTTPS domain, e.g. https://app.voicenuvo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SESSION AUTHENTICATION
# =============================================================================
# Classification: SECRET | SERVER_ONLY | REQUIRED
# Minimum 32 characters. Generate with: openssl rand -base64 48
# Must be rotated immediately if compromised.
# Default development value is REJECTED in production mode.
SESSION_SECRET=replace-this-with-a-real-32plus-character-random-string

# =============================================================================
# DATABASE
# =============================================================================
# Classification: SECRET | SERVER_ONLY | REQUIRED (production)
# PostgreSQL connection string. In production, DATABASE_URL is mandatory.
# The application will NOT start in production without a valid postgres:// URL.
# In development/test: if unset, falls back to embedded PGlite (local only).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Classification: SERVER_ONLY | OPTIONAL (development/test only)
# Directory for the embedded PGlite database. Ignored in production.
PGLITE_DATA_DIR=./data/voicenuvo_pg

# =============================================================================
# SUPABASE (Optional — used if Supabase is the PostgreSQL host)
# =============================================================================
# Classification: PUBLIC | OPTIONAL
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# Classification: PUBLIC | OPTIONAL
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Classification: SECRET | SERVER_ONLY | OPTIONAL
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# SEED DATA
# =============================================================================
# Classification: SERVER_ONLY | OPTIONAL
# MUST remain false in production.  Demo seed data creates fake orgs and users.
# The startup guard will refuse to seed if NODE_ENV=production.
SEED_DEMO_DATA=false

# =============================================================================
# OMNIDIMENSION VOICE PROVIDER
# =============================================================================
# Classification: SECRET | SERVER_ONLY | REQUIRED (for call functionality)
# API key for OmniDimension voice AI platform.
# Rotate immediately if key is logged or committed to source control.
OMNIDIM_API_KEY=replace-with-your-omnidimension-api-key

# Classification: SECRET | SERVER_ONLY | OPTIONAL
# If set, all incoming OmniDimension webhooks must carry this secret in
# X-Webhook-Secret or X-OmniDimension-Signature header.
# Strongly recommended in production.
OMNIDIM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# =============================================================================
# RAZORPAY PAYMENT GATEWAY
# =============================================================================
# Classification: SERVER_ONLY | REQUIRED (for billing functionality)
# Use rzp_test_* for test mode; rzp_live_* only in production with approval.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Classification: SECRET | SERVER_ONLY | REQUIRED (for billing functionality)
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
# Classification: SECRET | SERVER_ONLY | REQUIRED (for webhook verification)
# Obtain from Razorpay Dashboard → Webhooks → Secret.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# =============================================================================
# META (FACEBOOK LEAD ADS)
# =============================================================================
# Classification: SECRET | SERVER_ONLY | OPTIONAL
META_PAGE_ACCESS_TOKEN=replace-with-meta-page-access-token
# Classification: SERVER_ONLY | OPTIONAL
META_PAGE_ID=your-facebook-page-id
# Classification: SECRET | SERVER_ONLY | OPTIONAL
# Used to verify incoming webhook challenges from Meta.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-verify-token
# Classification: SECRET | SERVER_ONLY | OPTIONAL
META_APP_SECRET=replace-with-meta-app-secret

# =============================================================================
# ENCRYPTION
# =============================================================================
# Classification: SECRET | SERVER_ONLY | REQUIRED
# AES-256-GCM key for encrypting provider API keys at rest.
# Must be exactly 32 bytes (64 hex characters).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string-for-aes256-encryption

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Classification: SERVER_ONLY | OPTIONAL
# Safety guards for high-risk production operations.
# Default: false (off).  Set to true only after explicit production approval.
FEATURE_AUTO_CALLING=false
FEATURE_BULK_CAMPAIGNS=false
FEATURE_META_INGESTION=false
FEATURE_RAZORPAY_LIVE=false

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Classification: SECRET | SERVER_ONLY | OPTIONAL
# Sentry DSN for error tracking. Leave empty to disable Sentry integration.
SENTRY_DSN=
# Classification: SERVER_ONLY | OPTIONAL
# Application release version (git SHA, semver, build number).
# Exposed safely via /api/health and admin dashboard.
APP_VERSION=local
